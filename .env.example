# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (client + admin, no trailing slash)
# Production example: https://jeraplus.vercel.app,https://jeraplus-admin.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Admin auth ----
# Strong password, min 10 chars
ADMIN_PASSWORD=change-me-to-a-strong-password
# Random secret, min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL_HOURS=12

# ---- Supabase ----
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — server only, NEVER put it in the client/admin apps
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=jeraplus_media
